<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The bot core runs in this APK now; it watches interfaces for the
         "network changed -> reconnect now" path. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: the FGS notification is only drawn with this. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: specialUse requires the typed permission and a subtype
         property. dataSync is deliberately NOT used: it is capped at 6h/24h
         on Android 15+, which would silently stop the shell every night. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Opens the system dialog so HyperOS stops killing Termux + this app. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M3 step 3: libnode lives here, never in the UI process. nodejs-mobile
             allows one Node runtime per process and cannot restart it, so a bot
             crash must cost this process only; BridgeService supervises it. -->
        <service
            android:name=".NodeService"
            android:exported="false"
            android:process=":node" />

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the in-app Node bot core, its localhost WebSocket bridge and the control WebView while the screen is off." />
        </service>
    </application>
</manifest>
